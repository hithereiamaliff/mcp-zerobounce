{
  "name": "mcp-zerobounce",
  "version": "2.0.0",
  "description": "MCP server for the ZeroBounce email validation API: validation, AI scoring, email finder, allow/block filters, bulk files and list evaluation. Hosted via mcp-key-service or run locally over stdio.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-zerobounce": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:tsc",
    "build:tsc": "tsc",
    "dev": "npm run dev:http",
    "dev:http": "tsx src/http-server.ts",
    "start": "node dist/http-server.js",
    "start:http": "node dist/http-server.js",
    "cli": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke": "node scripts/smoke-test.mjs",
    "prepare": "npm run build",
    "docs:tools": "tsx scripts/generate-tools-md.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "zerobounce",
    "email",
    "email-validation",
    "email-verification",
    "email-finder"
  ],
  "author": "hithereiamaliff",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hithereiamaliff/mcp-zerobounce.git"
  },
  "bugs": {
    "url": "https://github.com/hithereiamaliff/mcp-zerobounce/issues"
  },
  "homepage": "https://github.com/hithereiamaliff/mcp-zerobounce#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
