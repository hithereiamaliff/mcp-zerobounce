# ZeroBounce MCP Server - environment variables
# Copy to .env and fill in what you need:  cp .env.sample .env
# Generate secrets with:                    openssl rand -hex 32

# =============================================================================
# Local CLI / stdio mode (npx mcp-zerobounce)
# =============================================================================
# Your ZeroBounce API key (ZeroBounce dashboard → API → API Keys).
# In HTTP mode this is only used as a fallback for self-hosted requests.
ZEROBOUNCE_API_KEY=

# Optional API region: blank/default, us, or eu.
#   default → api.zerobounce.net (processed in the EU)
#   us      → api-us.zerobounce.net (US-only processing)
#   eu      → api-eu.zerobounce.net (EU-only processing)
ZEROBOUNCE_REGION=

# =============================================================================
# Hosted mode (mcp-key-service) - used on the VPS
# =============================================================================
# Users connect with https://mcp.techmavie.digital/zerobounce/mcp/usr_...
# Both must be set together (or both left empty).
# Inside Docker on the shared mcp-network:
#   KEY_SERVICE_URL=http://mcp-key-service:8090/internal/resolve
# From outside Docker:
#   KEY_SERVICE_URL=https://mcpkeys.techmavie.digital/internal/resolve
KEY_SERVICE_URL=
# Must match the "zerobounce:<token>" entry in mcp-key-service's INTERNAL_SERVER_TOKENS.
KEY_SERVICE_TOKEN=
# Where users manage their keys (shown in error messages).
# KEY_PORTAL_URL=https://mcpkeys.techmavie.digital

# =============================================================================
# Self-hosted mode + analytics
# =============================================================================
# Shared secret for X-API-Key. Enables:
#   - POST /mcp with X-API-Key + X-ZeroBounce-Api-Key headers
#   - /analytics and the dashboard data
# Leave empty to disable both.
MCP_API_KEY=

# =============================================================================
# Optional
# =============================================================================
# PORT=8080
# HOST=0.0.0.0
# PUBLIC_BASE_PATH=/zerobounce          # prefix nginx adds (used in advertised URLs)
# ANALYTICS_DIR=/app/data
# ALLOWED_ORIGINS=*                     # comma-separated list for browser clients
# MCP_PROTOCOL_VERSION=2025-11-25
# MCP_BODY_LIMIT=10mb                   # max request size (bulk uploads sent inline)
# ZEROBOUNCE_MAX_RESULT_MB=20           # largest bulk results file the HTTP server will download/parse
# MCP_TRACE_HTTP=false                  # log one line per MCP request (no secrets)
# ENABLE_MCP_DIAGNOSTICS=false          # enables /mcp-debug/open (no-auth ping tool)
