# ZeroBounce MCP Server - Environment Variables
# Copy this to .env and fill in your values

# ZeroBounce API Key (required)
# Get yours at https://www.zerobounce.net/
ZEROBOUNCE_API_KEY=your_zerobounce_api_key_here

# Server Configuration (optional - defaults shown)
# PORT=8080
# HOST=0.0.0.0

# Analytics Configuration (optional)
# ANALYTICS_DIR=/app/data
# ANALYTICS_IMPORT_KEY=your_secret_import_key
